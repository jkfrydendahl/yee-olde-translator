# Environment Variables for Ye Olde Translator
#
# For deployment: Add these in your Vercel project dashboard
#   Settings → Environment Variables
#
# For local development: Copy this file to .env and fill in values
#   (The .env file is ignored by git and won't be uploaded)

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
